{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "flick",
  "account_id": "6020003af35d5415215cdb2467ad23f6",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "flick-db",
      "database_id": "13de56ff-6cbe-4a8d-ba94-ad5870eb5519",
      "migrations_dir": "migrations"
    }
  ],
  "ai": { "binding": "AI" },
  "observability": { "enabled": true },
  "env": {
    // Local E2E only: no remote AI binding, dev login + AI stub enabled. Never deployed.
    "e2e": {
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "flick-db",
          "database_id": "00000000-0000-0000-0000-000000000000",
          "migrations_dir": "migrations"
        }
      ],
      "vars": { "DEV_LOGIN": "1", "AI_MOCK": "1", "GOOGLE_CLIENT_ID": "e2e", "GOOGLE_CLIENT_SECRET": "e2e" }
    }
  }
}
