{
  "name": "flick",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "db:migrate:local": "wrangler d1 migrations apply flick-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply flick-db --remote",
    "start": "wrangler dev --port 8787",
    "deploy": "npm run build && wrangler d1 migrations apply flick-db --remote && wrangler deploy",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "hono": "^4.13.14",
    "motion": "^14.7.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261028.1",
    "@playwright/test": "1.63.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wrangler": "^4.154.0"
  }
}
